# Drizzle
DATABASE_URL=file:local.db

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Web Push (background reminder notifications)
# Generate with: bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# MCP server (read-only AI access)
# Generate with: openssl rand -hex 32
# Endpoint: POST /api/mcp with "Authorization: Bearer <MCP_TOKEN>".
# On a single-user instance both user variables can stay empty.
MCP_TOKEN=""
MCP_USER_EMAIL=""
MCP_USER_ID=""
