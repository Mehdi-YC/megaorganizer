# Drizzle
DATABASE_URL=file:local.db

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Web Push (background reminder notifications)
# Generate with: bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# MCP server (read-only AI access)
# No configuration needed: each account authenticates at POST /api/mcp with
# its own email and password, sent as
# "Authorization: Bearer <email>:<password>" or HTTP Basic auth.

